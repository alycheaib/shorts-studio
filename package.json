{
  "name": "shorts-studio-mcp",
  "version": "0.2.0",
  "description": "Turn a topic into a narrated short video (TikTok/Reels/Shorts) from inside Claude: script by Claude, free Edge TTS voiceover, stock footage, burned-in subtitles, ffmpeg render. Inspired by MoneyPrinterTurbo (MIT).",
  "type": "module",
  "bin": {
    "shorts-studio-mcp": "plugin/server.mjs"
  },
  "scripts": {
    "test": "node --test --no-warnings --test-concurrency=1 test/*.test.js",
    "build": "node scripts/build.mjs"
  },
  "license": "MIT",
  "author": "Aly Cheaib",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ffmpeg-static": "^5.3.0",
    "msedge-tts": "^2.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "files": [
    "plugin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": "github:alycheaib/shorts-studio",
  "keywords": [
    "mcp",
    "claude",
    "shorts",
    "tiktok",
    "reels",
    "video",
    "tts",
    "subtitles",
    "moneyprinterturbo"
  ]
}
